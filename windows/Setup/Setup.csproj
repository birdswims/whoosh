<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Whoosh\Assets\AppIcon.ico</ApplicationIcon>
    <AssemblyName>WhooshSetup</AssemblyName>
    <Version>0.1.0</Version>
    <Product>Whoosh</Product>
    <Company>Whoosh</Company>
    <Description>Install Whoosh for Windows.</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="payload.zip" Condition="Exists('payload.zip')">
      <LogicalName>whoosh-payload.zip</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
