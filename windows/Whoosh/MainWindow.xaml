<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Whoosh.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Whoosh"
    Title="Whoosh">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Root" AllowDrop="True" KeyDown="Root_KeyDown" DragOver="Root_DragOver" DragLeave="Root_DragLeave" Drop="Root_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="ChooseFiles_Invoked" />
            <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="Send_Invoked" />
            <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="ToggleReceive_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="CaptionSpacer" Width="192" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="DragRegion" Background="Transparent" />
            <StackPanel Margin="18,0,8,0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsHitTestVisible="False">
                <local:WhooshMark Width="28" Height="28" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock AutomationProperties.AutomationId="AppTitle" FontSize="16" FontWeight="SemiBold" Text="Whoosh" />
                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding StatusLine}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="0" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <Border Padding="10,4" VerticalAlignment="Center" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12" Visibility="{Binding ShowPin, Converter={StaticResource Vis}}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="PIN" />
                        <TextBlock VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" Text="{Binding Pin}" />
                    </StackPanel>
                </Border>
                <Border Padding="10,5" VerticalAlignment="Center" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="12">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource WhooshSignalBrush}" />
                        <TextBlock VerticalAlignment="Center" FontSize="12" Text="{Binding ReceivingLabel}" />
                    </StackPanel>
                </Border>
                <Button
                    AutomationProperties.AutomationId="ActivityButton"
                    MinWidth="44"
                    MinHeight="40"
                    Padding="10"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    VerticalAlignment="Center"
                    Click="Activity_Click"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Activity">
                    <FontIcon Width="22" Height="22" FontSize="16" Glyph="&#xE823;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button
                    AutomationProperties.AutomationId="SettingsButton"
                    MinWidth="44"
                    MinHeight="40"
                    Padding="10"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    VerticalAlignment="Center"
                    Click="Settings_Click"
                    Style="{StaticResource SubtleButtonStyle}"
                    ToolTipService.ToolTip="Settings">
                    <FontIcon Width="22" Height="22" FontSize="16" Glyph="&#xE713;" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar
            x:Name="Banner"
            Grid.Row="1"
            Margin="18,0,18,0"
            IsClosable="True"
            IsOpen="{Binding HasBanner, Mode=OneWay}"
            Message="{Binding Banner}"
            Severity="Error"
            Closed="Banner_Closed" />

        <TextBlock
            Grid.Row="2"
            Margin="22,8,22,0"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            MaxLines="2"
            Text="{Binding WarningsText}"
            TextWrapping="Wrap"
            Visibility="{Binding HasWarnings, Converter={StaticResource Vis}}" />

        <Grid Grid.Row="3" Margin="18,12,18,8" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="SEND" />
                    <Border
                        x:Name="DropWell"
                        Grid.Row="1"
                        Height="112"
                        Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                            <FontIcon x:Name="DropIcon" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE8E5;" />
                            <TextBlock x:Name="DropLabel" HorizontalAlignment="Center" FontWeight="Medium" Text="Drop files" />
                            <HyperlinkButton AutomationProperties.AutomationId="ChooseFiles" Click="ChooseFiles_Click" Content="Choose…" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Visibility="{Binding HasFiles, Converter={StaticResource Vis}}">
                        <ItemsRepeater ItemsSource="{Binding Files}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="4" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="84" Height="108">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Width="72" Height="72" Margin="0,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8">
                                            <Grid>
                                                <FontIcon
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="18"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Glyph="{Binding Glyph}"
                                                    Visibility="{Binding ShowGlyph, Converter={StaticResource Vis}}" />
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" Visibility="{Binding HasThumbnail, Converter={StaticResource Vis}}" />
                                            </Grid>
                                        </Border>
                                        <Button
                                            Width="22"
                                            Height="22"
                                            Padding="0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            AutomationProperties.Name="Remove"
                                            Click="RemoveFile_Click"
                                            Content="&#xE711;"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                            FontSize="10"
                                            Tag="{Binding Path}" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Width="76"
                                            Margin="0,4,0,0"
                                            HorizontalAlignment="Left"
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                    <TextBox
                        Grid.Row="3"
                        FontFamily="Cascadia Mono, Consolas"
                        PlaceholderText="Pin, if they asked for one"
                        Text="{Binding OutgoingPin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding ShowOutgoingPin, Converter={StaticResource Vis}}" />
                    <TextBlock
                        Grid.Row="4"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding Hint}"
                        TextWrapping="WrapWholeWords" />
                    <Button
                        x:Name="SendButton"
                        Grid.Row="6"
                        HorizontalAlignment="Right"
                        MinWidth="180"
                        AutomationProperties.AutomationId="SendButton"
                        Click="Send_Click"
                        Content="{Binding SendTitle}"
                        IsEnabled="{Binding CanSend}"
                        Style="{StaticResource AccentButtonStyle}" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="NEARBY" />
                        <ProgressRing
                            Width="16"
                            Height="16"
                            HorizontalAlignment="Right"
                            IsActive="{Binding ShowLooking}"
                            Visibility="{Binding ShowLooking, Converter={StaticResource Vis}}" />
                    </Grid>
                    <TextBlock
                        x:Name="NearbyStatus"
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="NearbyStatus"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding NearbyMessage}"
                        Visibility="{Binding ShowNearbyMessage, Converter={StaticResource Vis}}" />
                    <ListView
                        x:Name="PeerList"
                        Grid.Row="1"
                        AutomationProperties.AutomationId="NearbyList"
                        SelectionChanged="PeerList_SelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4,2" AutomationProperties.Name="{Binding Name}" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="Medium" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontFamily="Cascadia Mono, Consolas"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Detail}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Padding="8,3" VerticalAlignment="Center" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10">
                                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding ProtocolLabel}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="22,4,22,16">
            <Button
                AutomationProperties.AutomationId="SaveFolder"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Click="SaveFolder_Click"
                Style="{StaticResource SubtleButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding SaveLabel}" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                </StackPanel>
            </Button>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <TextBlock VerticalAlignment="Center" Text="Receiving" />
                <ToggleSwitch
                    x:Name="ReceivingToggle"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="ReceivingToggle"
                    AutomationProperties.Name="Receiving"
                    OffContent=""
                    OnContent=""
                    Toggled="Receiving_Toggled" />
            </StackPanel>
        </Grid>

        <Grid x:Name="OfferLayer" Grid.RowSpan="5" Background="#66000000" Tapped="OfferSmoke_Tapped" Visibility="{Binding HasOffer, Converter={StaticResource Vis}}">
            <Border Width="440" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Card}" Tapped="Card_Tapped">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="OfferPeer" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="OfferSummary" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel x:Name="OfferPinPanel" Spacing="4" Visibility="Collapsed">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="COMPARE THIS CODE" />
                        <TextBlock x:Name="OfferPin" FontFamily="Cascadia Mono, Consolas" FontSize="32" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock x:Name="OfferProtected" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Protected by your pin" Visibility="Collapsed" />
                    <ScrollViewer MaxHeight="180">
                        <ItemsControl x:Name="OfferFiles">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="{Binding Glyph}" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding SizeLabel}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                        <Button AutomationProperties.AutomationId="OfferDecline" Click="Decline_Click" Content="Decline" />
                        <Button AutomationProperties.AutomationId="OfferAccept" Click="Accept_Click" Content="Accept" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="TrustLayer" Grid.RowSpan="5" Background="#66000000" Tapped="TrustSmoke_Tapped" Visibility="{Binding HasTrust, Converter={StaticResource Vis}}">
            <Border Width="460" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Card}" Tapped="Card_Tapped">
                <StackPanel Spacing="14">
                    <TextBlock x:Name="TrustTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="TrustBody" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="TrustPrint"
                        Padding="12"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="13"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                        <Button Click="TrustCancel_Click" Content="Cancel" />
                        <Button AutomationProperties.AutomationId="TrustSend" Click="TrustSend_Click" Content="Trust and send" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="5" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Visibility="{Binding EngineDown, Converter={StaticResource Vis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <local:WhooshMark Width="52" Height="52" HorizontalAlignment="Center" />
                <TextBlock HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="Whoosh stopped" />
                <TextBlock
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding EngineError}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button AutomationProperties.AutomationId="Retry" HorizontalAlignment="Center" Click="Retry_Click" Content="Try Again" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
