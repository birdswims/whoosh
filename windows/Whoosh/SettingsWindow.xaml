<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Whoosh.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Whoosh"
    Title="Settings">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <ScrollViewer x:Name="Root">
        <StackPanel Padding="24" Spacing="18">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <local:WhooshMark Width="28" Height="28" />
                    <TextBlock VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="Settings" />
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{Binding Version}" />
            </Grid>

            <StackPanel Spacing="6">
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Name" />
                <TextBox x:Name="NameBox" KeyDown="NameBox_KeyDown" LostFocus="NameBox_LostFocus" PlaceholderText="This PC" />
            </StackPanel>

            <Grid>
                <StackPanel Spacing="2">
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Save to" />
                    <TextBlock Text="{Binding SaveLabel}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="ChooseFolder_Click" Content="Choose…" />
            </Grid>

            <Border Padding="8,4" Style="{StaticResource Card}">
                <StackPanel Spacing="2">
                    <Grid Padding="8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="Whoosh" />
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Other computers running Whoosh" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="NativeSwitch" Grid.Column="1" MinWidth="0" OffContent="" OnContent="" Toggled="Protocol_Toggled" />
                    </Grid>
                    <Grid Padding="8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="Quick Share" />
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Android phones on this Wi-Fi" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="QuickSwitch" Grid.Column="1" MinWidth="0" OffContent="" OnContent="" Toggled="Protocol_Toggled" />
                    </Grid>
                    <Grid Padding="8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="AirDrop" />
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Receivers on this network. iPhones use a link Windows does not have." TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AirDropSwitch" Grid.Column="1" MinWidth="0" OffContent="" OnContent="" Toggled="Protocol_Toggled" />
                    </Grid>
                    <Grid Padding="8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="Sort photos and videos" />
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Keep them in their own folders" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SortSwitch" Grid.Column="1" MinWidth="0" OffContent="" OnContent="" Toggled="Protocol_Toggled" />
                    </Grid>
                    <Grid Padding="8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="Require a pin" />
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Whoosh senders enter the code in the window" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch x:Name="PinSwitch" Grid.Column="1" MinWidth="0" OffContent="" OnContent="" Toggled="Protocol_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Spacing="8">
                <Grid>
                    <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Fingerprint" />
                    <Button HorizontalAlignment="Right" Click="Copy_Click" Content="Copy" Style="{StaticResource SubtleButtonStyle}" />
                </Grid>
                <TextBlock
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="13"
                    IsTextSelectionEnabled="True"
                    Text="{Binding GroupedFingerprint}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Visibility}" TextWrapping="Wrap" Visibility="{Binding Visibility, Converter={StaticResource VisText}}" />
        </StackPanel>
    </ScrollViewer>
</Window>
